{
  "name": "pv-row-wind",
  "description": "三座傾斜光伏支架沿風向排成一列（前後間距 5 m），風從面板低邊（正面）吹來；tiltDeg 正值是 +z 邊抬高，風吹往 +z；看第一座的風壓與後排的遮蔽效應。",
  "frame": { "up": "y", "units": "mm", "origin": [0, 0, 0] },
  "flow": {
    "medium": "air",
    "direction": [0, 0, 1],
    "profile": "abl",
    "Uref": 12,
    "Zref": 10000,
    "z0": 30
  },
  "ground": { "level": 0 },
  "domain": { "upstream": "5H", "downstream": "12H", "lateral": "4H", "height": "6H" },
  "mesh": {
    "baseCell": 800,
    "nCellsBetweenLevels": 2,
    "wake": { "level": 2 },
    "geometryMode": "searchable"
  },
  "obstacles": [
    { "name": "table1", "label": "支架 1（迎風）", "type": "plate", "group": "panels", "center": [0, 1350, -5000], "size": [6800, 2300], "thickness": 60, "tiltDeg": 20, "level": [5, 5] },
    { "name": "table2", "label": "支架 2", "type": "plate", "group": "panels", "center": [0, 1350, 0], "size": [6800, 2300], "thickness": 60, "tiltDeg": 20, "level": [5, 5] },
    { "name": "table3", "label": "支架 3", "type": "plate", "group": "panels", "center": [0, 1350, 5000], "size": [6800, 2300], "thickness": 60, "tiltDeg": 20, "level": [5, 5] },
    { "name": "inverter", "label": "變流器箱", "type": "box", "center": [5200, 600, 0], "size": [800, 1200, 600], "level": [3, 3], "report": true },
    { "name": "pole", "label": "監控桿", "type": "cylinder", "center": [-5200, 2000, 0], "radius": 80, "height": 4000, "axis": "y", "level": [3, 4] }
  ],
  "solver": { "application": "simpleFoam", "turbulence": "kOmegaSST", "iterations": 800, "writeInterval": 200, "nProcs": 4, "residual": 1e-4 },
  "sampling": {
    "autoSlices": true,
    "slices": [ { "name": "behind1", "point": [0, 1500, -2500], "normal": [0, 0, 1] } ],
    "probes": [ { "name": "gap12", "point": [0, 2500, -2500] }, { "name": "wake", "point": [0, 1500, 9000] } ],
    "streamlines": { "nSeeds": 24 }
  }
}
